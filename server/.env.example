# Port the local dev server and the Docker image listen on.
PORT=4000

NODE_ENV=development

# Upstream facts API. Defaults to https://api.chucknorris.io/jokes when unset.
BASE_URL=

# Comma-separated list of browser origins allowed to call the API. Only needed
# when the client is served from a different origin than the server — on Vercel
# and behind the Docker nginx proxy they share one, so CORS never applies.
CLIENT_URL=http://localhost:3000

# pino level: fatal | error | warn | info | debug | trace. Defaults to info.
LOG_LEVEL=
